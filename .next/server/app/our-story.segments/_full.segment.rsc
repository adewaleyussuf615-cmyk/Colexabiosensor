c:["$","section",null,{"className":"quality-policy","aria-labelledby":"quality-policy-title","children":[["$","div",null,{"className":"quality-policy-header","children":[["$","p",null,{"className":"eyebrow","children":"Our commitment to quality"}],["$","h2",null,{"id":"quality-policy-title","children":"Quality Policy Statement - QR-01-02"}],["$","p",null,{"children":"Colexa Biosensor Ltd is an in-vitro diagnostic medical device manufacturer. Our vision is to become the leading manufacturer of medical devices and IVD devices in Sub-Saharan Africa. Our mission is to be the manufacturer of choice in Nigeria and across Africa by 2030."}]]}],["$","div",null,{"className":"policy-grid","children":[["$","article",null,{"className":"policy-card","children":[["$","h3",null,{"children":"Shareholders"}],["$","ul",null,{"children":[["$","li",null,{"children":"Managing our organization along with established quality objectives and defined responsibilities for their fulfilment."}],["$","li",null,{"children":"Establishing, applying, implementing, and continual improvement of our processes based on the requirements of ISO 9001:2015 Quality Management System, and ISO 13485:2016 Medical Devices Quality Management System."}]]}]]}],["$","article",null,{"className":"policy-card","children":[["$","h3",null,{"children":"Customers"}],["$","ul",null,{"children":[["$","li",null,{"children":"Considering economic realities and affordability of our products to enable"}],["$","li",null,{"children":"Consistently enhance customer satisfaction by engaging the right people, acting with integrity, being dynamic, maintaining high ethical standards, ensuring timely delivery of our products and timely after sales"}]]}]]}],["$","article",null,{"className":"policy-card","children":[["$","h3",null,{"children":"Interested Parties"}],["$","ul",null,{"children":[["$","li",null,{"children":"Satisfying the requirements of our regulators and statutory"}],["$","li",null,{"children":"Continuous engagement with other stakeholder groups [shareholders, employees, customers] on our corporate activities in line with achieving our vision and mission."}]]}]]}],["$","article",null,{"className":"policy-card","children":[["$","h3",null,{"children":"Employees"}],["$","ul",null,{"children":[["$","li",null,{"children":"Creating and promoting an exciting and rewarding work environment that motivates members of staff and fosters"}],["$","li",null,{"children":"Equipping them with adequate tools and technical"}]]}]]}]]}],["$","div",null,{"className":"policy-signoff","children":[["$","div",null,{"children":["$","p",null,{"children":"The management of Colexa is committed to ensuring continual improvement to the quality management system and will review this policy periodically for continued applicability."}]}],["$","div",null,{"className":"policy-signature","children":[["$","$L4",null,{"src":"/images/brand-story/quality-policy-signature.png","alt":"Colexa Biosensor Chief Executive Officer signature and official stamp","width":162,"height":77}],["$","p",null,{"children":"Signed 14-12-2023"}],["$","strong",null,{"children":"Chief Executive Officer"}]]}]]}]]}]

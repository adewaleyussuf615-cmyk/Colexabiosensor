0:{"buildId":"j8SH7vBzJ3wqp6aCyYuGT","rsc":["$","$1","c",{"children":[["$","main",null,{"className":"story-page","aria-labelledby":"story-title","children":["$","div",null,{"className":"container story-page-inner","children":[["$","div",null,{"className":"story-page-header","children":[["$","p",null,{"className":"eyebrow","children":"Our brand story"}],["$","h1",null,{"id":"story-title","children":"Our Brand Story"}],["$","div",null,{"className":"story-page-intro","children":[["$","p",null,{"children":"Colexa Biosensor Ltd began with a technology transfer aimed at localizing and building backward integration for blood glucose meters and strips - a first for Sub-Saharan Africa. The company grew out of Codix Pharma Limited, which had already supplied over 75 million glucose monitoring and rapid diagnostic kits to Nigeria since 2010."}],["$","p",null,{"children":"The company was co-founded by Samson Ogunjimi and Pharm. Lekan Asuni, both veterans of multinational pharmaceutical companies, with a shared goal of building Africa's diagnostic device manufacturing capacity from the ground up."}],["$","p",null,{"children":"Using GDH-FAD sensor technology, Colexa manufactures two core product lines: blood glucose monitoring strips and the meters that pair with them, giving people with diabetes a reliable way to track their condition day to day."}],["$","p",null,{"children":"The factory runs at an installed capacity of 3.6 million strip packs a year, with room to scale further as demand grows - first across Nigeria, then the wider continent. Colexa holds ISO 9001:2015 and ISO 13485:2016 certification, and the operation has created over 1,000 jobs, with 20+ years of combined leadership experience across government, private sector, and international partnerships."}]]}]]}],["$","div",null,{"className":"story-gallery","aria-label":"Colexa Biosensor brand story gallery","children":[["$","figure","/images/brand-story/colexa-1.jpg",{"className":"story-gallery-item story-gallery-item-1","children":["$","$L2",null,{"src":"/images/brand-story/colexa-1.jpg","alt":"Colexa Biosensor team and manufacturing environment","fill":true,"sizes":"(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw"}]}],["$","figure","/images/brand-story/img-5056.jpg",{"className":"story-gallery-item story-gallery-item-2","children":["$","$L2",null,{"src":"/images/brand-story/img-5056.jpg","alt":"Colexa Biosensor manufacturing floor","fill":true,"sizes":"(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw"}]}],["$","figure","/images/brand-story/img-5041.jpg",{"className":"story-gallery-item story-gallery-item-3","children":["$","$L2",null,{"src":"/images/brand-story/img-5041.jpg","alt":"Colexa Biosensor staff working in the facility","fill":true,"sizes":"(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw"}]}],["$","figure","/images/brand-story/img-4652.jpg",{"className":"story-gallery-item story-gallery-item-4","children":["$","$L2",null,{"src":"/images/brand-story/img-4652.jpg","alt":"Colexa Biosensor team member in the production area","fill":true,"sizes":"(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw"}]}],["$","figure","/images/brand-story/img-4653.jpg",{"className":"story-gallery-item story-gallery-item-5","children":["$","$L2",null,{"src":"/images/brand-story/img-4653.jpg","alt":"Colexa Biosensor diagnostics manufacturing equipment","fill":true,"sizes":"(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw"}]}],["$","figure","/images/brand-story/img-4665.jpg",{"className":"story-gallery-item story-gallery-item-6","children":["$","$L2",null,{"src":"/images/brand-story/img-4665.jpg","alt":"Colexa Biosensor production and quality team","fill":true,"sizes":"(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw"}]}],["$","figure","/images/brand-story/img-4679.jpg",{"className":"story-gallery-item story-gallery-item-7","children":"$L3"}],"$L4"]}],"$L5"]}]}],["$L6"],"$L7"]}],"loading":null,"isPartial":false}
